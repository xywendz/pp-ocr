APP_NAME=PP-OCR API
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
MODELS_DIR=./models
STRICT_MODEL_LOAD=true
ONNX_PROVIDERS=CPUExecutionProvider
ORT_INTRA_OP_NUM_THREADS=-1
ORT_INTER_OP_NUM_THREADS=-1
MAX_UPLOAD_SIZE_MB=20
DEFAULT_REGION_TYPES=image,chart,header_image,footer_image
DEFAULT_LAYOUT_THRESHOLD=0.5
DEFAULT_OCR_THRESHOLD=0.5
DEFAULT_REGION_ASSOCIATION=hybrid
LAYOUT_BBOX_SCALE_MODE=auto
OCR_LIMIT_SIDE_LEN=960
ENABLE_ORIENTATION_CORRECTION=true
ORIENTATION_THRESHOLD=0.3
